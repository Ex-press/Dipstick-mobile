# Copy to keystore.properties (which is gitignored) and fill in.
# Generate the keystore with:
#   keytool -genkeypair -v -keystore dipstick-upload.jks \
#     -alias dipstick -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the project root.
storeFile=dipstick-upload.jks
storePassword=CHANGE_ME
keyAlias=dipstick
keyPassword=CHANGE_ME
