<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#40000000" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#3A3A44" />
                    <stroke android:width="3dp" android:color="#5A5A66" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Pressed: the face drops onto its shadow, like a real sticker-button. -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/d_black" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/d_white" />
                    <stroke android:width="3dp" android:color="@color/d_black" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/d_black" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/d_white" />
                    <stroke android:width="3dp" android:color="@color/d_black" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
